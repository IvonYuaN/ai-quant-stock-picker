# AQSP 双服务器部署配置文件
# 使用方法: 复制本文件为 deploy-config.env 并填写实际配置

# ============================================================
# 前端服务器配置
# ============================================================

# 前端服务器地址（公网IP或域名）
FRONTEND_SERVER=your-frontend-server.com

# SSH 登录用户
FRONTEND_USER=root

# 公网域名（用于 Nginx 和 HTTPS）
FRONTEND_DOMAIN=lh.ifidy.cn

# ============================================================
# 数据服务器配置
# ============================================================

# 数据服务器地址（公网IP或域名）
BACKEND_SERVER=your-backend-server.com

# 数据服务器内网地址（如果有，用于前端服务器连接）
# 留空则使用 BACKEND_SERVER
BACKEND_SERVER_INTERNAL=

# SSH 登录用户
BACKEND_USER=root

# ============================================================
# 部署配置
# ============================================================

# 代码仓库地址
GITHUB_REPO=https://github.com/yourusername/AI量化选股.git

# 服务器部署路径
DEPLOY_PATH=/opt/aqsp

# ============================================================
# 可选：API Key 配置（用于后端鉴权）
# ============================================================

# 如果需要 API Key 鉴权，在这里设置
# 注意：实际的 API Key 应该在服务器的 .env 文件中配置
# 这里仅用于部署脚本验证
# VR_API_KEY=your_secure_api_key_here
